# Server
PORT=5000

# Groq API (get your key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# Groq models used across the app
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_interview_db

# Interview settings
INTERVIEW_DURATION_MINUTES=15
MAX_QUESTIONS=12
PROCTOR_MAX_VIOLATIONS=4
VOICE_SIMILARITY_THRESHOLD=0.68


# Store browser speech transcripts only; disable biometric voice checks.
VOICE_CHECK_ENABLED=false

# Production: set the exact HTTPS frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_RELOAD=false
